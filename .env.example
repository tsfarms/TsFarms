# Copy to .env.local and fill in from Firebase Console > Project settings > Your apps > Web app.
# The public shop works without these; they are only needed for /admin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tsmangoes-001.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tsmangoes-001
VITE_FIREBASE_STORAGE_BUCKET=tsmangoes-001.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
