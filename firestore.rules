rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /varieties/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mango_varieties/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /products/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orders/{doc} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    match /enquiries/{doc} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }
  }
}
