rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings — anyone reads, only admin writes
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mango varieties — anyone reads, only admin writes
    match /mango_varieties/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Products — anyone reads, only admin writes
    match /products/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders — anyone creates (customer checkout),
    //          only admin reads and updates
    match /orders/{doc} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    // Enquiries — anyone creates, only admin reads and updates
    match /enquiries/{doc} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }
  }
}
